<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/mobile_navigation"
app:startDestination="@id/nav_liste_etudiants" >
<fragment
    android:id="@+id/nav_liste_etudiants"
    android:name="com.iset.tproom.ui.fragments.ListeEtudiantsFragment"
    android:label="Liste des étudiants" >

    <action
        android:id="@+id/action_nav_liste_etudiants_to_nav_detail_etudiant"
        app:destination="@id/nav_detail_etudiant" />

</fragment>
<fragment
    android:id="@+id/nav_ajout_etudiant"
    android:name="com.iset.tproom.ui.fragments.AjoutEtudiantFragment"
    android:label="Ajouter un étudiant" >

    <action
        android:id="@+id/action_nav_ajout_etudiant_to_nav_liste_etudiants"
        app:destination="@id/nav_liste_etudiants"
        app:popUpTo="@id/nav_ajout_etudiant"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/nav_detail_etudiant"
    android:name="com.iset.tproom.ui.fragments.DetailEtudiantFragment"
    android:label="Détails de l&apos;étudiant" />
</navigation>